# IA local gratuita: no hace falta OPENAI_API_KEY.
MOTOR_LOCAL=llama
OPENAI_BASE_URL=http://127.0.0.1:8088/v1
OPENAI_MODEL=qwen2.5-local
ZONA_HORARIA=America/Bogota
OPENAI_TEMPERATURE=0.2
JSON_MODE=1
# ARCHIVO_CITAS=datos/citas.json

# Para usar Ollama, reemplaza las tres primeras variables por:
# MOTOR_LOCAL=ollama
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_MODEL=qwen2.5:3b
# Luego ejecuta npm run preparar.
